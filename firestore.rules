rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user is the owner of the resource
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profiles
    match /users/{userId} {
      allow read: if true; // Public profiles
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasAll(['id', 'username', 'email'])
        && request.resource.data.id == userId
        && request.resource.data.username is string
        && request.resource.data.email is string;
      allow update: if isOwner(userId)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['id']));
      allow delete: if isOwner(userId);
    }

    // Boards
    match /boards/{boardId} {
      allow read: if true; // Boards are public by default (privacy handled in app logic)
      allow create: if isAuthenticated()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.keys().hasAll(['ownerId', 'title', 'slug', 'blocks', 'theme', 'privacy'])
        && request.resource.data.title is string
        && request.resource.data.slug is string
        && request.resource.data.blocks is list
        && request.resource.data.privacy is string;
      allow update: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid || 
        (resource.data.collaborators != null && request.auth.uid in resource.data.collaborators)
      )
        // Prevent changing the owner
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['ownerId']));
      allow delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }

    // Analytics events - allow public creates for tracking, reads for authenticated users
    match /analytics/{eventId} {
      allow create: if true
        && request.resource.data.keys().hasAll(['boardId', 'date'])
        && request.resource.data.boardId is string
        && request.resource.data.date is string;
      allow update: if true
        && request.resource.data.boardId is string;
      allow read: if isAuthenticated();
    }

    // Click events
    match /clicks/{clickId} {
      allow create: if true
        && request.resource.data.keys().hasAll(['boardId', 'blockId'])
        && request.resource.data.boardId is string
        && request.resource.data.blockId is string;
      allow read: if isAuthenticated();
    }
  }
}
