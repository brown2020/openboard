rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isBoardOwner() {
      return isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }

    function isBoardCollaborator() {
      return isAuthenticated()
        && resource.data.collaborators != null
        && request.auth.uid in resource.data.collaborators;
    }

    function isPublicBoard() {
      return resource.data.privacy in ['public', 'unlisted'];
    }

    // User profiles — authenticated reads (public pages use Admin SDK)
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasAll(['id', 'username', 'email'])
        && request.resource.data.id == userId
        && request.resource.data.username is string
        && request.resource.data.email is string;
      allow update: if isOwner(userId)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['id']));
      allow delete: if isOwner(userId);
    }

    // Boards — public/unlisted readable; private/password via owner/collaborator or Admin SDK
    match /boards/{boardId} {
      allow read: if isPublicBoard() || isBoardOwner() || isBoardCollaborator();
      allow create: if isAuthenticated()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.keys().hasAll(['ownerId', 'title', 'slug', 'blocks', 'theme', 'privacy'])
        && request.resource.data.title is string
        && request.resource.data.slug is string
        && request.resource.data.blocks is list
        && request.resource.data.privacy is string;
      allow update: if (isBoardOwner() || isBoardCollaborator())
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['ownerId']));
      allow delete: if isBoardOwner();
    }

    // Analytics — owners read; anonymous create for public page tracking with schema checks
    match /analytics/{eventId} {
      allow create: if request.resource.data.keys().hasAll(['boardId', 'date'])
        && request.resource.data.boardId is string
        && request.resource.data.date is string
        && request.resource.data.boardId.size() > 0
        && request.resource.data.date.size() == 10;
      allow update: if request.resource.data.boardId is string
        && request.resource.data.boardId == resource.data.boardId;
      allow read: if isAuthenticated();
    }

    // Click events — schema-validated creates; owners read via auth
    match /clicks/{clickId} {
      allow create: if request.resource.data.keys().hasAll(['boardId', 'blockId'])
        && request.resource.data.boardId is string
        && request.resource.data.blockId is string
        && request.resource.data.boardId.size() > 0
        && request.resource.data.blockId.size() > 0;
      allow read: if isAuthenticated();
    }
  }
}
